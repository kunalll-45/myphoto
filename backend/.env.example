# ==============================================================================
# Photo Vault Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Backend Configuration
# ------------------------------------------------------------------------------
# Port the Express server listens on (standard EC2 deployment: 5000 or 8080)
PORT=5000

# Host to bind the HTTP server to (0.0.0.0 binds to all network interfaces on EC2)
HOST=0.0.0.0

# Runtime environment ('development', 'production', or 'test')
NODE_ENV=development

# Base URL for the backend API (used for constructing external links)
API_BASE_URL=http://localhost:5000

# Allowed CORS origins (use '*' or comma-separated URLs e.g. https://mygallery.com)
CORS_ORIGIN=*

# ALB (Application Load Balancer) proxy trust setting:
# '1' trusts the first front-facing proxy (ALB). Set to 'true' or hop count.
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 2. Authentication & Security
# ------------------------------------------------------------------------------
# JWT signing secret key (must be a strong, random secret in production)
JWT_SECRET=replace-with-a-very-long-secure-random-secret-key-32-chars

# Token expiration time (e.g. '7d', '24h')
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. Storage Driver Configuration
# ------------------------------------------------------------------------------
# Storage driver: 'local' (local disk storage) or 's3' (AWS S3)
STORAGE_DRIVER=local

# Local storage path root (only used when STORAGE_DRIVER=local)
STORAGE_ROOT=./storage

# ------------------------------------------------------------------------------
# 4. AWS S3 Configuration (Used when STORAGE_DRIVER=s3)
# ------------------------------------------------------------------------------
# AWS Region where the S3 bucket is hosted
AWS_REGION=us-east-1

# S3 Bucket Name
AWS_S3_BUCKET_NAME=my-photo-vault-gallery-bucket

# S3 Key Prefixes for incoming (original) and processed assets
AWS_S3_INCOMING_PREFIX=incoming/
AWS_S3_PROCESSED_PREFIX=processed/

# Optional: AWS Access Keys for local development only.
# NOTE: For production EC2 deployment, DO NOT set these keys!
# The backend automatically authenticates using the EC2 instance's IAM Role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 5. Database Configuration
# ------------------------------------------------------------------------------
# Database host / endpoint
DB_HOST=localhost

# Database port
DB_PORT=5432

# Database name
DB_NAME=gallery

# Database credentials
DB_USER=gallery_user
DB_PASSWORD=

# Enable SSL for database connections (recommended for cloud RDS)
DB_SSL=false

# SQLite database file path (used for local/embedded database)
DB_PATH=./data/gallery.db

# ------------------------------------------------------------------------------
# 6. Image Processing Configuration
# ------------------------------------------------------------------------------
# Compression quality for processed images (1-100, default: 80)
IMAGE_QUALITY=80

# Image format for processed and thumbnail files ('jpeg' or 'webp')
IMAGE_FORMAT=jpeg

# Thumbnail width in pixels (default: 400)
THUMBNAIL_WIDTH=400

# Thumbnail height in pixels (default: 400)
THUMBNAIL_HEIGHT=400

# Maximum allowed file upload size in bytes (default: 52428800 = 50MB)
MAX_UPLOAD_SIZE=52428800

