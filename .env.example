# ==============================================================================
# Photo Vault Root Environment Configuration Example
# ==============================================================================

PORT=5000
HOST=0.0.0.0
NODE_ENV=development
API_BASE_URL=http://localhost:5000
CORS_ORIGIN=*
TRUST_PROXY=1

JWT_SECRET=replace-with-a-very-long-secure-random-secret-key-32-chars
JWT_EXPIRES_IN=7d

STORAGE_DRIVER=local
STORAGE_ROOT=./backend/storage

AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=photo-vault-gallery-bucket
AWS_S3_INCOMING_PREFIX=incoming/
AWS_S3_PROCESSED_PREFIX=processed/

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gallery
DB_USER=gallery_user
DB_PASSWORD=
DB_SSL=false
DB_PATH=./backend/data/gallery.db

IMAGE_QUALITY=80
IMAGE_FORMAT=jpeg
THUMBNAIL_WIDTH=400
THUMBNAIL_HEIGHT=400
MAX_UPLOAD_SIZE=52428800

